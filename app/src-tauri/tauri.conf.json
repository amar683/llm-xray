{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM X-Ray",
  "version": "0.9.0",
  "identifier": "dev.llmxray.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare-uv && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-uv && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLM X-Ray",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "../../engine/xray": "engine/xray",
      "../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../engine/uv.lock": "engine/uv.lock",
      "../../engine/.python-version": "engine/.python-version",
      "../../engine/LICENSE": "engine/LICENSE"
    },
    "category": "DeveloperTool",
    "shortDescription": "Measure what a local language model does inside.",
    "license": "Apache-2.0"
  }
}
